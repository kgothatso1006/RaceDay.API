@using System.Text.Json
@model List<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Race Results</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
    </div>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Race History</h5>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <p class="text-muted">You haven't completed any races yet.</p>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Category</th>
                            <th>Race Number</th>
                            <th>Finish Time</th>
                            <th>Position</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            var eventName = result.GetProperty("eventName").GetString();
                            var categoryName = result.GetProperty("categoryName").GetString();
                            var raceNumber = result.GetProperty("raceNumber").GetString();
                            var status = result.GetProperty("resultStatus").GetString();

                            // Handle nullable times and positions
                            var finishTime = result.GetProperty("finishTime").ValueKind == JsonValueKind.Null ? "N/A" : result.GetProperty("finishTime").GetString();
                            var position = result.GetProperty("position").ValueKind == JsonValueKind.Null ? "N/A" : result.GetProperty("position").GetInt32().ToString();

                            <tr>
                                <td class="fw-bold">@eventName</td>
                                <td>@categoryName</td>
                                <td>@raceNumber</td>
                                <td>@finishTime</td>
                                <td>@position</td>
                                <td>
                                    @if (status == "Finished")
                                    {
                                        <span class="badge bg-success">Finished</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-warning text-dark">@status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>