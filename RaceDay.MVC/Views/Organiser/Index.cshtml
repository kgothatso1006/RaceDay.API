@model List<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-action="Logout" asp-controller="Auth" class="btn btn-danger">Logout</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">My Events</h4>
            <a asp-action="CreateEvent" class="btn btn-light btn-sm">+ Create New Event</a>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <p class="text-muted">You haven't created any events yet. Click "Create New Event" to get started.</p>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Venue</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            var eventId = ev.GetProperty("eventID").GetInt32();
                            var eventName = ev.GetProperty("eventName").GetString();
                            var eventDate = ev.GetProperty("eventDate").GetDateTime();
                            var venue = ev.GetProperty("venue").GetString();
                            var status = ev.GetProperty("status").GetString();

                            <tr>
                                <td class="fw-bold">@eventName</td>
                                <td>@eventDate.ToString("dd MMM yyyy")</td>
                                <td>@venue</td>
                                <td><span class="badge bg-info text-dark">@status</span></td>
                                <td>
                                    <a asp-action="ManageCategories" asp-route-id="@eventId" class="btn btn-sm btn-primary">Manage Categories</a>
                                    <a asp-action="EventEnrolments" asp-route-id="@eventId" class="btn btn-sm btn-warning">View Enrolments</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>